{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "wk guard-bash", "timeout": 15 }] },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "wk guard-edit", "timeout": 15 }]
      }
    ]
  }
}
